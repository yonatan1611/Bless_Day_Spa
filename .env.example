# Copy to .env.local for local dev (gitignored). In Vercel, set these under
# Project → Settings → Environment Variables instead — none of them should
# ever be prefixed VITE_ or referenced from client code.

# Menu admin (/admin) — see docs/admin-setup.md
DATABASE_URL=
DIRECT_URL=
NEON_BRANCH=
BLOB_READ_WRITE_TOKEN=
# Signs/verifies the admin session cookie. Any long random string, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
# Only read by `npm run prisma:seed`, to create the first admin login —
# not used at runtime afterward. Change the password once logged in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
